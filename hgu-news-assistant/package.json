{
  "name": "hgu-news-assistant",
  "version": "1.0.0",
  "description": "HGU News Assistant Application",
  "author": "GXL",
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "dist": "npm run build && npm run rebuild && electron-builder",
    "rebuild": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.hgu.newsassistant",
    "productName": "HGU News Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.3",
    "cheerio": "^1.0.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.0.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/better-sqlite3": "^7.6.9"
  },
  "overrides": {
    "undici": "5.28.4"
  }
}